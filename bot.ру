import asyncio
import logging
import os

from aiogram import Bot, Dispatcher, F
from aiogram.types import ChatJoinRequest, ChatMemberUpdated, Message

TOKEN = os.getenv("BOT_TOKEN")

if not TOKEN:
    raise RuntimeError("BOT_TOKEN is not set")

# Пока здесь оставляем текущее голосовое.
# Когда получим новый VOICE FILE ID, заменим только эту строку.
VOICE_FILE_ID = "AwACAgIAAxkBAAMDan4PpwOhtrDyCSJSA7b2mamFrm4AAkqkAAJ1BvFL12r5ZScIDpQ9BA"

dp = Dispatcher()

# Сохраняем заявки, которые ещё не были одобрены.
pending_requests = set()


# --------------------------------------------------
# ПОЛУЧЕНИЕ НОВОГО ГОЛОСОВОГО
# --------------------------------------------------

@dp.message(F.voice)
async def voice_handler(message: Message):
    file_id = message.voice.file_id

    print(f"VOICE FILE ID: {file_id}")

    await message.answer("Голосовое получено!")


# --------------------------------------------------
# НОВАЯ ЗАЯВКА НА ВСТУПЛЕНИЕ
# --------------------------------------------------

@dp.chat_join_request()
async def join_request_handler(request: ChatJoinRequest):
    chat_id = request.chat.id
    user_id = request.from_user.id

    pending_requests.add((chat_id, user_id))

    print(
        f"Новая заявка: "
        f"user_id={user_id}, "
        f"chat_id={chat_id}"
    )


# --------------------------------------------------
# ПОЛЬЗОВАТЕЛЬ СТАЛ УЧАСТНИКОМ
# --------------------------------------------------

@dp.chat_member()
async def member_update_handler(
    update: ChatMemberUpdated,
    bot: Bot
):
    old_status = update.old_chat_member.status
    new_status = update.new_chat_member.status

    # Пользователь был не участником,
    # а теперь стал участником.
    if new_status in ("member", "restricted") and old_status in (
        "left",
        "kicked",
    ):
        chat_id = update.chat.id
        user_id = update.new_chat_member.user.id

        key = (chat_id, user_id)

        if key in pending_requests:
            pending_requests.discard(key)

            print(
                f"Заявка принята вручную: "
                f"user_id={user_id}"
            )

            try:
                # Отправляем голосовое именно В ГРУППУ.
                await bot.send_voice(
                    chat_id=chat_id,
                    voice=VOICE_FILE_ID,
                )

                print(
                    f"Голосовое отправлено в группу "
                    f"chat_id={chat_id}"
                )

            except Exception as e:
                print(
                    f"Не удалось отправить голосовое "
                    f"в группу: {e}"
                )


# --------------------------------------------------
# ЗАПУСК БОТА
# --------------------------------------------------

async def main():
    logging.basicConfig(level=logging.INFO)

    bot = Bot(token=TOKEN)

    print("БОТ ЗАПУЩЕН")
    print("Ожидаю заявки на вступление...")

    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
