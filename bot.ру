import asyncio
import logging
import os

from aiogram import Bot, Dispatcher, F
from aiogram.types import (
    ChatJoinRequest,
    ChatMemberUpdated,
    Message,
)

TOKEN = os.getenv("BOT_TOKEN")

if not TOKEN:
    raise RuntimeError("BOT_TOKEN is not set")

# Голосовое, которое бот отправляет в группу
VOICE_FILE_ID = (
    "AwACAgIAAxkBAAMFan4XjF37hCYdq_1ZWjWciV6GCfoAAk-qAALgtvFL"
    "4vVoVFGSrdg9BA"
)

dp = Dispatcher()

# Здесь храним заявки до момента фактического вступления
pending_requests = set()


# ==========================================
# ПОЛУЧЕНИЕ ГОЛОСОВОГО
# ==========================================

@dp.message(F.voice)
async def voice_handler(message: Message):
    print("================================")
    print("ПОЛУЧЕНО НОВОЕ ГОЛОСОВОЕ")
    print(f"VOICE FILE ID: {message.voice.file_id}")
    print("================================")

    await message.answer("Голосовое получено!")


# ==========================================
# НОВАЯ ЗАЯВКА
# ==========================================

@dp.chat_join_request()
async def join_request_handler(request: ChatJoinRequest):
    chat_id = request.chat.id
    user_id = request.from_user.id

    pending_requests.add((chat_id, user_id))

    print("================================")
    print("НОВАЯ ЗАЯВКА")
    print(f"user_id: {user_id}")
    print(f"chat_id: {chat_id}")
    print("================================")


# ==========================================
# ИЗМЕНЕНИЕ СТАТУСА УЧАСТНИКА
# ==========================================

@dp.chat_member()
async def member_update_handler(
    update: ChatMemberUpdated,
    bot: Bot,
):
    old_status = update.old_chat_member.status
    new_status = update.new_chat_member.status

    chat_id = update.chat.id
    user_id = update.new_chat_member.user.id

    print("================================")
    print("CHAT MEMBER UPDATE")
    print(f"user_id: {user_id}")
    print(f"chat_id: {chat_id}")
    print(f"old status: {old_status}")
    print(f"new status: {new_status}")
    print("================================")

    # Пользователь вошёл в группу
    if new_status in ("member", "restricted") and old_status in (
        "left",
        "kicked",
    ):
        key = (chat_id, user_id)

        if key in pending_requests:
            pending_requests.discard(key)

            print("================================")
            print("ЗАЯВКА ПРИНЯТА ВРУЧНУЮ")
            print(f"user_id: {user_id}")
            print("Отправляю голосовое в группу...")
            print("================================")

            try:
                await bot.send_voice(
                    chat_id=chat_id,
                    voice=VOICE_FILE_ID,
                )

                print("================================")
                print("ГОЛОСОВОЕ ОТПРАВЛЕНО В ГРУППУ")
                print(f"chat_id: {chat_id}")
                print("================================")

            except Exception as e:
                print("================================")
                print("ОШИБКА ОТПРАВКИ ГОЛОСОВОГО")
                print(str(e))
                print("================================")


# ==========================================
# ЗАПУСК
# ==========================================

async def main():
    logging.basicConfig(level=logging.INFO)

    bot = Bot(token=TOKEN)

    print("================================")
    print("БОТ ЗАПУЩЕН")
    print("Ожидаю заявки на вступление...")
    print("================================")

    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
